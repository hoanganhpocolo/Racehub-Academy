# Copy this file to .env and fill with REAL values (‑ .env is gitignored).
# On Vercel: set these under Settings → Environment Variables (Production).
# NEVER put real keys in this .env.example file — it is committed to git.

# Google Sheets (service account with Sheets API enabled; share the sheet with this email as Editor)
SHEET_ID=your_google_sheet_id_from_the_url
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Resend (verify racehub-academy.com to send from your domain; test: onboarding@resend.dev)
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM="Racehub Academy <noreply@racehub-academy.com>"
NOTIFY_EMAIL=petr@racehub-academy.com
