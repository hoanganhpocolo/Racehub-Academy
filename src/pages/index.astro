---
// Splash + language gate served at "/".
// Shows the animated logo + a progress bar; when it finishes, the bar is
// replaced by the English / Tiếng Việt choice that leads into /en/ or /vi/.
const site = Astro.site ?? new URL('http://localhost:4321');
const enUrl = new URL('/en/', site).href;
const viUrl = new URL('/vi/', site).href;
const rootUrl = new URL('/', site).href;
const ogImage = new URL('/assets/images/social-image.jpg', site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Racehub Driver's Academy</title>
    <meta
      name="description"
      content="Structured karting training in Vietnam — racecraft, coaching, and a real pathway from first laps to competitive racing."
    />

    <link rel="canonical" href={rootUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="vi" href={viUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <!-- Favicons -->
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/images/favicon-192.png" />
    <link rel="apple-touch-icon" href="/assets/images/apple-touch-icon.png" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={rootUrl} />
    <meta property="og:site_name" content="Racehub Driver's Academy" />
    <meta property="og:title" content="Racehub Driver's Academy" />
    <meta
      property="og:description"
      content="Structured karting training in Vietnam — racecraft, coaching, and a real pathway from first laps to competitive racing."
    />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/SFUEurostileBoldOblique.woff2" crossorigin />

    <link rel="stylesheet" href="/css/style.css" />

    <!-- Google Fonts loaded non-render-blocking -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Barlow:wght@300;400;500;600;700&family=Barlow+Condensed:wght@400;500;600;700&family=Bebas+Neue&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Barlow:wght@300;400;500;600;700&family=Barlow+Condensed:wght@400;500;600;700&family=Bebas+Neue&display=swap"
      />
    </noscript>

    <style>
      .splash {
        position: fixed;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg, #ffffff);
        z-index: 9999;
      }

      .splash-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3rem;
        padding: 2rem;
      }

      .splash-logo {
        width: clamp(210px, 44vw, 320px);
        height: auto;
        display: block;
      }

      /* Shared slot: progress bar and language buttons stack in the same grid
         cell so they cross-fade in place without a layout shift. */
      .splash-slot {
        display: grid;
        justify-items: center;
        align-items: center;
        width: min(300px, 84vw);
      }

      .splash-slot > * {
        grid-area: 1 / 1;
      }

      .splash-progress {
        width: min(260px, 72vw);
        height: 3px;
        background: rgba(17, 17, 17, 0.12);
        overflow: hidden;
        transition: opacity 0.4s ease;
      }

      .splash-progress.done {
        opacity: 0;
      }

      .splash-bar {
        display: block;
        height: 100%;
        width: 0;
        background: var(--red, #d91212);
      }

      .splash-langs {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        opacity: 0;
        visibility: hidden;
        transform: translateY(8px);
        transition: opacity 0.5s ease, transform 0.5s ease, visibility 0.5s ease;
      }

      .splash-langs.show {
        opacity: 1;
        visibility: visible;
        transform: none;
      }

      .splash-lang {
        width: 100%;
        font-family: var(--font-heading, sans-serif);
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--white, #111111);
        text-decoration: none;
        padding: 1rem 1.5rem;
        height: 58px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
        border: 1px solid var(--border-light, #d5d5d5);
        transition: background 0.25s, color 0.25s, border-color 0.25s, transform 0.15s;
      }

      .splash-lang:hover {
        background: var(--red, #d91212);
        color: #ffffff;
        border-color: var(--red, #d91212);
        transform: translateY(-1px);
      }

      /* No-JS: skip the progress and show the choices immediately */
      .no-js .splash-progress {
        display: none;
      }
      .no-js .splash-langs {
        opacity: 1;
        visibility: visible;
        transform: none;
      }
    </style>
  </head>

  <body>
    <main class="splash" id="splash">
      <div class="splash-inner">
        <img class="splash-logo" src="/assets/images/Logo-animated.svg" alt="Racehub Driver's Academy" width="320" height="105" />
        <div class="splash-slot">
          <div class="splash-progress" id="splashProgress"><span class="splash-bar" id="splashBar"></span></div>
          <div class="splash-langs" id="splashLangs" role="group" aria-label="Choose language">
            <a class="splash-lang" href="/en/">English</a>
            <a class="splash-lang" href="/vi/">Tiếng Việt</a>
          </div>
        </div>
      </div>
    </main>

    <noscript>
      <style>
        .splash-progress { display: none; }
        .splash-langs { opacity: 1 !important; visibility: visible !important; transform: none !important; }
      </style>
    </noscript>

    <script is:inline>
      (() => {
        const progress = document.getElementById('splashProgress');
        const bar = document.getElementById('splashBar');
        const langs = document.getElementById('splashLangs');
        if (!progress || !bar || !langs) return;

        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const DURATION = reduce ? 400 : 2600;

        bar.style.transition = 'width ' + DURATION + 'ms cubic-bezier(0.4, 0, 0.1, 1)';
        // Kick off the fill on the next frames so the transition applies.
        requestAnimationFrame(() => requestAnimationFrame(() => { bar.style.width = '100%'; }));

        setTimeout(() => {
          progress.classList.add('done');
          langs.classList.add('show');
        }, DURATION + 250);
      })();
    </script>
  </body>
</html>
